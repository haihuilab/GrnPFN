# Whitelist: code only (no manuscript, data, results, environments)
/*
!/.gitignore
!/pyproject.toml
!/README.md
!/LICENSE
!/src/
!/eval/
!/tests/
/eval/results/**
!/eval/results/**/
!/eval/results/**/*.sh
__pycache__/
*.pyc
*.pt
*.npz
*.pkl
*.h5ad
*.csv
*.log

